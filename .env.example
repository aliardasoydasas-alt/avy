VITE_APP_NAME=AVY
VITE_DATA_MODE=live
VITE_ENABLE_DESKTOP_NOTIFICATIONS=true
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Auto-update publish channel for packaged installers.
# AVY reads this during `npm run dist` from `.env` or the shell environment.
# Example: AVY_UPDATE_URL=https://updates.example.com/avy/win
AVY_UPDATE_URL=
GITHUB_REPOSITORY=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=

# Shared AVY AI uses Supabase Edge Function secrets.
# End users do not need to enter any OpenAI key in the app.

# Future-ready provider keys
VITE_FINNHUB_API_KEY=
VITE_ALPHA_VANTAGE_API_KEY=
VITE_NEWS_API_KEY=
VITE_POLYGON_API_KEY=

# Future websocket endpoints
VITE_CRYPTO_WS_URL=wss://stream.binance.com:9443/ws
VITE_MARKET_WS_URL=
