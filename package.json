{
  "name": "avy-terminal",
  "version": "0.1.10",
  "private": true,
  "author": "AVY",
  "description": "AVY desktop investment tracking and analysis terminal built with Electron, React and TypeScript.",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis portable",
    "publish:update:github": "node scripts/publish-github-release.mjs",
    "publish:update:supabase": "node scripts/upload-supabase-update.mjs",
    "preview": "electron-vite preview",
    "preview:web": "vite preview --config vite.web.config.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.3",
    "@tanstack/react-query": "^5.62.9",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "lightweight-charts": "^4.2.3",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react-swc": "^3.7.1",
    "electron": "^33.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
